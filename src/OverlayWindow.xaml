<Window x:Class="NexusIA.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS IA overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Box" Background="#E8101821" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="12,9">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Fg}">
            <!-- FPS em destaque (cada parte aparece só se escolhida na aba Overlay) -->
            <StackPanel x:Name="OFpsRow" Orientation="Horizontal">
                <TextBlock x:Name="OFps" Text="—" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="OFpsUnit" Text=" FPS" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <TextBlock x:Name="OFrameTime" Text="" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
            </StackPanel>
            <TextBlock x:Name="OLow" Text="1% low —" Foreground="{DynamicResource Muted}"/>
            <!-- Gráfico de frametime -->
            <Canvas x:Name="OGraph" Width="190" Height="30" Margin="0,6,0,4" ClipToBounds="True"/>
            <!-- Linhas de sensores: GPU, VRAM, CPU, RAM... montadas pelo que foi escolhido -->
            <ItemsControl x:Name="ORows" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="OGame" Text="" Foreground="{DynamicResource Faint}" FontSize="10" Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>
